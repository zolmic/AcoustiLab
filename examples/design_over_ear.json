{
  "schema": "acoustilab-netlist/0.2",
  "title": "Over-ear headphone: parametric design template (theory-only)",
  "description": "A 40 mm dynamic driver in an over-ear cup. The front cavity is a cylinder between the driver and the ear, sealed by the pad except for a leak gap around its inner edge. The back of the driver sees either a closed rear cavity vented through holes that can carry a mesh, or an open grille. The ear load is the IEC 60318-4 simulator or the ITU-T P.57 Type 4.3 ear. Driver defaults are the Tymphany HPD-40N16PET00-32 primary set (docs/spec-errata.md E5); tolerances are datasheet values where stated and estimates otherwise. Geometry is illustrative, not a measured product.",
  "ui": {"template": "over_ear", "primary_probe": "p_drp"},
  "parameters": {
    "driver_fs_Hz": {"value": 81.8, "min": 20, "max": 400, "step": 0.1, "log": true,
      "label": "Resonance fs (free air)", "group": "Driver",
      "tolerance": {"rel": 0.15, "source": "datasheet (Tymphany HPD-40N16PET00-32)"}},
    "driver_Qms": {"value": 2.71, "min": 0.3, "max": 15, "step": 0.01, "log": true,
      "label": "Mechanical Q (Qms)", "group": "Driver",
      "tolerance": {"rel": 0.1, "source": "estimate"}},
    "driver_Qes": {"value": 1.01, "min": 0.1, "max": 10, "step": 0.01, "log": true,
      "label": "Electrical Q (Qes)", "group": "Driver",
      "tolerance": {"rel": 0.1, "source": "estimate"}},
    "driver_Re_ohm": {"value": 32.8, "min": 4, "max": 600, "step": 0.1, "log": true,
      "label": "Coil resistance Re", "group": "Driver",
      "tolerance": {"rel": 0.05, "source": "datasheet (Tymphany HPD-40N16PET00-32)"}},
    "driver_Mms_g": {"value": 0.3, "min": 0.05, "max": 3, "step": 0.005, "log": true,
      "label": "Moving mass Mms", "group": "Driver",
      "tolerance": {"rel": 0.05, "source": "estimate"}},
    "driver_Sd_cm2": {"value": 10, "min": 2, "max": 25, "step": 0.1,
      "label": "Diaphragm area Sd", "group": "Driver"},
    "driver_Le_uH": {"value": 0, "min": 0, "max": 1000, "step": 1,
      "label": "Coil inductance Le", "group": "Driver", "advanced": true,
      "description": "Near zero for most headphone drivers (spec Section 4); a few hundred microhenries would falsely roll off the treble of a 32 ohm driver."},
    "driver_Xmax_mm": {"value": 0.8, "min": 0.05, "max": 5, "step": 0.05,
      "label": "Linear excursion Xmax", "group": "Driver", "advanced": true},
    "driver_rated_power_mW": {"value": 10, "min": 1, "max": 1000, "step": 1, "log": true,
      "label": "Rated power", "group": "Driver", "advanced": true},

    "front_radius_mm": {"value": 25, "min": 15, "max": 40, "step": 0.5,
      "label": "Cup inner radius", "group": "Front cavity",
      "description": "Radius of the cylindrical space between the driver and the ear; also the pad's inner edge, which sets the leak perimeter."},
    "front_depth_mm": {"value": 15, "min": 3, "max": 40, "step": 0.5,
      "label": "Driver-to-ear depth", "group": "Front cavity",
      "tolerance": {"abs": 0.3, "source": "estimate (pad compression)"}},
    "front_volume_cm3": {"expr": "pi * front_radius_mm^2 * front_depth_mm / 1000",
      "label": "Front volume", "group": "Front cavity"},

    "leak_gap_mm": {"value": 0.08, "min": 0, "max": 1, "step": 0.01,
      "label": "Pad leak gap (0 = sealed)", "group": "Pad and leak",
      "description": "Mean gap between the pad and the head or fixture, as a thermoviscous slit around the pad's inner edge. Fit varies this from person to person.",
      "tolerance": {"rel": 0.5, "dist": "lognormal", "source": "estimate (fit variation)"}},
    "pad_width_mm": {"value": 15, "min": 3, "max": 40, "step": 0.5,
      "label": "Pad face width (leak depth)", "group": "Pad and leak"},
    "leak_perimeter_mm": {"expr": "2 * pi * front_radius_mm",
      "label": "Leak perimeter", "group": "Pad and leak"},

    "rear": {"value": "closed", "choices": [
      {"value": "closed", "label": "Closed cup with vents"},
      {"value": "open", "label": "Open back (grille)"}],
      "label": "Back of the driver", "group": "Rear"},
    "rear_volume_cm3": {"value": 25, "min": 2, "max": 150, "step": 0.5, "log": true,
      "label": "Rear cavity volume", "group": "Rear",
      "tolerance": {"rel": 0.03, "source": "estimate (moulding)"}},
    "rear_depth_mm": {"expr": "rear_volume_cm3 * 1000 / (pi * front_radius_mm^2)",
      "label": "Rear cavity depth", "group": "Rear"},
    "vent_count": {"value": 1, "min": 0, "max": 12, "integer": true,
      "label": "Number of rear vents", "group": "Rear"},
    "vent_diameter_mm": {"value": 3, "min": 0.3, "max": 8, "step": 0.1,
      "label": "Vent diameter", "group": "Rear",
      "tolerance": {"abs": 0.05, "source": "estimate (moulding)"}},
    "vent_length_mm": {"value": 2, "min": 0.3, "max": 20, "step": 0.1,
      "label": "Vent length (wall thickness)", "group": "Rear"},
    "vent_mesh_rayl": {"value": 160, "min": 0, "max": 2000, "step": 5,
      "label": "Vent mesh resistance (0 = open hole)", "group": "Rear",
      "description": "Specific flow resistance of a mesh covering each vent, MKS rayl (160 is the Saati Acoustex grade the spec cites).",
      "tolerance": {"rel": 0.12, "source": "industry practice (10-15 %)"}},
    "grille_rayl": {"value": 30, "min": 0.5, "max": 1000, "step": 0.5, "log": true,
      "label": "Open-back grille resistance", "group": "Rear",
      "description": "Specific flow resistance of the grille and its fabric over the diaphragm area, MKS rayl (used when the back is open)."},

    "ear": {"value": "iec60318_4", "choices": [
      {"value": "iec60318_4", "label": "IEC 60318-4 ear simulator"},
      {"value": "type43", "label": "ITU-T P.57 Type 4.3 ear (canal and drum)"}],
      "label": "Ear load", "group": "Ear"},

    "source_impedance_ohm": {"value": 0, "min": 0, "max": 300, "step": 0.5,
      "label": "Amplifier output impedance", "group": "Source",
      "description": "0 ohm ideal, below 1 ohm portable, 10 ohm desktop, 120 ohm the legacy IEC 61938 figure."},
    "drive_mW": {"value": 1, "min": 0.001, "max": 1000, "step": 0.001, "log": true,
      "label": "Drive power into the rated impedance", "group": "Source",
      "description": "Every level states its drive: this is the power into the rated impedance (1 mW is the usual sensitivity reference). Warnings such as vent velocity and excursion are checked at this drive."},
    "rated_impedance_ohm": {"value": 32, "min": 4, "max": 600, "step": 1, "log": true,
      "label": "Rated impedance", "group": "Source", "advanced": true},

    "fidelity": {"value": 1, "min": 0, "max": 1, "integer": true,
      "label": "Model level (0 lumped, 1 distributed)", "group": "Model", "advanced": true},
    "points_per_octave": {"value": 24, "min": 6, "max": 96, "integer": true,
      "label": "Frequency points per octave", "group": "Model", "advanced": true}
  },
  "air": {"preset": "standard_23C"},
  "sweep": {"f_min_Hz": 10, "f_max_Hz": 20000, "points_per_octave": "=points_per_octave"},
  "level": "=fidelity",
  "drive": {"power_mW": "=drive_mW", "rated_ohm": "=rated_impedance_ohm"},
  "nodes": [
    {"id": "e_in", "domain": "electrical"},
    {"id": "a_front", "domain": "acoustic"},
    {"id": "a_ear", "domain": "acoustic"},
    {"id": "a_rear", "domain": "acoustic"},
    {"id": "a_grille", "domain": "acoustic", "enabled": "=rear == 'open'"}
  ],
  "elements": [
    {"id": "amp", "type": "vsource", "node": "e_in", "V_V": 1, "Zs_ohm": "=source_impedance_ohm"},
    {"id": "drv", "type": "driver", "nodes": ["e_in", "gnd", "a_front", "a_rear"], "model": "D1",
     "fs_Hz": "=driver_fs_Hz", "Qms": "=driver_Qms", "Qes": "=driver_Qes", "Re_ohm": "=driver_Re_ohm",
     "Mms_g": "=driver_Mms_g", "Sd_cm2": "=driver_Sd_cm2", "Le_uH": "=driver_Le_uH",
     "Xmax_mm": "=driver_Xmax_mm", "rated_power_mW": "=driver_rated_power_mW"},
    {"id": "front", "type": "cavity", "nodes": ["a_front", "a_ear"],
     "radius_mm": "=front_radius_mm", "depth_mm": "=front_depth_mm"},
    {"id": "leak", "type": "leak", "nodes": ["a_ear", "ambient"], "enabled": "=leak_gap_mm > 0",
     "perimeter_mm": "=leak_perimeter_mm", "depth_mm": "=pad_width_mm", "gap_mm": "=leak_gap_mm"},
    {"id": "ear", "type": "iec60318_4", "node": "a_ear", "enabled": "=ear == 'iec60318_4'"},
    {"id": "ear", "type": "type43", "node": "a_ear", "enabled": "=ear == 'type43'"},
    {"id": "rear", "type": "cavity", "node": "a_rear", "volume_cm3": "=rear_volume_cm3",
     "max_distance_mm": "=hypot(front_radius_mm, rear_depth_mm)", "enabled": "=rear == 'closed'"},
    {"id": "vent", "type": "vent", "nodes": ["a_rear", "ambient"],
     "enabled": "=rear == 'closed' && vent_count > 0 && vent_mesh_rayl > 0",
     "diameter_mm": "=vent_diameter_mm", "length_mm": "=vent_length_mm", "count": "=vent_count",
     "mesh": {"R_s_rayl": "=vent_mesh_rayl"}},
    {"id": "vent", "type": "vent", "nodes": ["a_rear", "ambient"],
     "enabled": "=rear == 'closed' && vent_count > 0 && vent_mesh_rayl == 0",
     "diameter_mm": "=vent_diameter_mm", "length_mm": "=vent_length_mm", "count": "=vent_count"},
    {"id": "grille", "type": "mesh", "nodes": ["a_rear", "a_grille"], "enabled": "=rear == 'open'",
     "R_s_rayl": "=grille_rayl", "area_cm2": "=driver_Sd_cm2"},
    {"id": "grille_rad", "type": "radiation", "nodes": ["a_grille", "ambient"],
     "enabled": "=rear == 'open'", "area_cm2": "=driver_Sd_cm2", "baffle": "infinite"}
  ],
  "probes": [
    {"id": "p_drp", "quantity": "pressure", "node": "ear.drp"},
    {"id": "p_front", "quantity": "pressure", "node": "a_front"},
    {"id": "p_rear", "quantity": "pressure", "node": "a_rear"},
    {"id": "zin", "quantity": "impedance", "element": "amp"},
    {"id": "x", "quantity": "displacement", "node": "drv.m"},
    {"id": "u_vent", "quantity": "volume_velocity", "element": "vent",
     "enabled": "=rear == 'closed' && vent_count > 0"},
    {"id": "u_leak", "quantity": "volume_velocity", "element": "leak", "enabled": "=leak_gap_mm > 0"}
  ]
}
