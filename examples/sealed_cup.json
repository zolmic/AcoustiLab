{
  "schema": "acoustilab-netlist/0.1",
  "title": "40 mm driver in a sealed front cavity with a pad leak (theory-only example)",
  "air": {"preset": "standard_23C"},
  "sweep": {"f_min_Hz": 10, "f_max_Hz": 20000, "points_per_octave": 24},
  "level": 1,
  "nodes": [
    {"id": "e_in", "domain": "electrical"},
    {"id": "e_coil", "domain": "electrical"},
    {"id": "m_dia", "domain": "mechanical"},
    {"id": "a_front", "domain": "acoustic"},
    {"id": "a_rear", "domain": "acoustic"},
    {"id": "a_rear_out", "domain": "acoustic"}
  ],
  "elements": [
    {"id": "amp", "type": "vsource", "node": "e_in", "V_V": 1.0, "Zs_ohm": 0},
    {"id": "coil", "type": "coil", "nodes": ["e_in", "e_coil"], "Re_ohm": 32.8},
    {"id": "motor", "type": "motor", "nodes": ["e_coil", "gnd", "m_dia", "gnd"], "Bl_Tm": 2.24},
    {"id": "susp", "type": "suspension", "node": "m_dia",
     "Mms_g": 0.3, "Cms_mm_per_N": 12.6, "Rms_Ns_per_m": 0.057},
    {"id": "dia", "type": "piston", "nodes": ["m_dia", "gnd", "a_front", "a_rear"], "Sd_cm2": 10},
    {"id": "front", "type": "cavity", "node": "a_front", "volume_cm3": 30},
    {"id": "rear", "type": "cavity", "node": "a_rear", "volume_cm3": 20},
    {"id": "rear_vent", "type": "tube", "nodes": ["a_rear", "a_rear_out"], "diameter_mm": 2, "length_mm": 1.5, "inlet": "flanged"},
    {"id": "vent_rad", "type": "radiation", "node": "a_rear_out", "radius_mm": 1},
    {"id": "pad_leak", "type": "slit", "nodes": ["a_front", "ambient"], "gap_mm": 0.2, "width_mm": 30, "length_mm": 10}
  ],
  "probes": [
    {"id": "p_front", "quantity": "pressure", "node": "a_front"},
    {"id": "zin", "quantity": "impedance", "element": "amp"},
    {"id": "x", "quantity": "displacement", "node": "m_dia"},
    {"id": "u_leak", "quantity": "volume_velocity", "element": "pad_leak"}
  ]
}
