{
  "schema": "acoustilab-netlist/0.2",
  "title": "Driver identification bench (theory-only)",
  "description": "A moving-coil driver on a test bench, parameterised by its physical set (Re, Bl, Mms, Cms, Rms, Sd) for parameter identification (docs/fitting.md). The bench conditions are parameters: a test mass glued to the diaphragm (added-mass method) and a sealed box of known volume on the front face (known-volume method); both zero is free air. Free air here has no radiation load: Mms, Cms and Rms include the air load of free air, as a datasheet's do. The defaults are the Tymphany HPD-40N16PET00-32 physical set derived from its primary set (docs/spec-errata.md E5); creep and the lossy inductance are off.",
  "ui": {"primary_probe": "zin"},
  "parameters": {
    "Re_ohm": {"value": 32.8, "min": 1, "max": 1000, "log": true, "step": 0.1,
      "label": "Coil resistance Re", "group": "Driver",
      "tolerance": {"rel": 0.05, "source": "datasheet (Tymphany HPD-40N16PET00-32)"}},
    "Bl_Tm": {"value": 2.2377, "min": 0.05, "max": 20, "log": true, "step": 0.01,
      "label": "Force factor Bl", "group": "Driver"},
    "Mms_g": {"value": 0.3, "min": 0.01, "max": 30, "log": true, "step": 0.005,
      "label": "Moving mass Mms", "group": "Driver"},
    "Cms_mm_per_N": {"value": 12.62, "min": 0.01, "max": 100, "log": true, "step": 0.01,
      "label": "Suspension compliance Cms", "group": "Driver"},
    "Rms_Ns_per_m": {"value": 0.05689, "min": 0.001, "max": 10, "log": true, "step": 0.001,
      "label": "Mechanical resistance Rms", "group": "Driver"},
    "Sd_cm2": {"value": 10, "min": 0.5, "max": 100, "log": true, "step": 0.1,
      "label": "Effective area Sd", "group": "Driver"},
    "creep_lambda": {"value": 0, "min": 0, "max": 0.3, "step": 0.005,
      "label": "Creep factor", "group": "Driver", "advanced": true},
    "Le_uH": {"value": 0, "min": 0, "max": 2000, "step": 1,
      "label": "Coil inductance Le", "group": "Driver", "advanced": true},
    "L2_uH": {"value": 0, "min": 0, "max": 2000, "step": 1,
      "label": "Eddy-current inductance L2 of the LR-2 branch (0 = none)", "group": "Driver", "advanced": true},
    "R2_ohm": {"value": 10, "min": 0.01, "max": 1000, "log": true, "step": 0.1,
      "label": "Eddy-current resistance R2", "group": "Driver", "advanced": true},
    "added_mass_mg": {"value": 0, "min": 0, "max": 10000, "step": 1,
      "label": "Test mass on the diaphragm (0 = none)", "group": "Bench"},
    "box_volume_cm3": {"value": 0, "min": 0, "max": 10000, "step": 0.1,
      "label": "Sealed box on the front face (0 = free air)", "group": "Bench"},
    "drive_V": {"value": 1, "min": 0.001, "max": 20, "log": true, "step": 0.001,
      "label": "Drive voltage (EMF)", "group": "Bench"}
  },
  "air": {"preset": "standard_23C"},
  "sweep": {"f_min_Hz": 10, "f_max_Hz": 20000, "points_per_octave": 24},
  "level": 0,
  "drive": {"voltage_V": "=drive_V"},
  "nodes": [
    {"id": "e_in", "domain": "electrical"},
    {"id": "e_drv", "domain": "electrical", "enabled": "=L2_uH > 0"},
    {"id": "a_box", "domain": "acoustic", "enabled": "=box_volume_cm3 > 0"}
  ],
  "elements": [
    {"id": "amp", "type": "vsource", "node": "e_in", "V_V": 1, "Zs_ohm": 0},
    {"id": "drv", "type": "driver", "model": "D1",
     "nodes": ["=if(L2_uH > 0, 'e_drv', 'e_in')", "gnd", "=if(box_volume_cm3 > 0, 'a_box', 'ambient')", "ambient"],
     "Re_ohm": "=Re_ohm", "Bl_Tm": "=Bl_Tm", "Mms_g": "=Mms_g", "Cms_mm_per_N": "=Cms_mm_per_N",
     "Rms_Ns_per_m": "=Rms_Ns_per_m", "Sd_cm2": "=Sd_cm2", "creep_lambda": "=creep_lambda",
     "Le_uH": "=Le_uH"},
    {"id": "eddy_L", "type": "inductor", "nodes": ["e_in", "e_drv"], "L_uH": "=L2_uH",
     "enabled": "=L2_uH > 0"},
    {"id": "eddy_R", "type": "resistor", "nodes": ["e_in", "e_drv"], "R_ohm": "=R2_ohm",
     "enabled": "=L2_uH > 0"},
    {"id": "test_mass", "type": "mass", "node": "drv.m", "M_mg": "=added_mass_mg",
     "enabled": "=added_mass_mg > 0"},
    {"id": "box", "type": "cavity", "node": "a_box", "volume_cm3": "=box_volume_cm3",
     "enabled": "=box_volume_cm3 > 0"}
  ],
  "probes": [
    {"id": "zin", "quantity": "impedance", "element": "amp"},
    {"id": "x", "quantity": "displacement", "node": "drv.m"},
    {"id": "p_box", "quantity": "pressure", "node": "a_box", "enabled": "=box_volume_cm3 > 0"}
  ]
}
